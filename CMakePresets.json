{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 4,
        "minor": 2,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "common",
            "hidden": true,
            "cacheVariables": {
                "SKSE_SUPPORT_XBYAK": "ON"
            },
            "binaryDir": "${sourceDir}/build/${presetName}"
        },
        {
            "name": "no-vcpkg",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchain-no-vcpkg.cmake",
                "ENABLE_SKYRIM_SE": "ON",
                "ENABLE_SKYRIM_AE": "ON",
                "ENABLE_SKYRIM_VR": "ON"
            }
        },
        {
            "name": "win64",
            "inherits": ["common", "no-vcpkg"],
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "NINJA",
            "inherits": ["win64"]
        }
    ],
    "buildPresets": [
        {
            "name": "NINJA",
            "configurePreset": "NINJA"
        }
    ]
}
